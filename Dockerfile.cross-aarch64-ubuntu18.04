# Cross-build an Ubuntu 18.04 ARM64 binary from an x86_64 host.
FROM ubuntu:18.04

ARG DEBIAN_FRONTEND=noninteractive

RUN printf '%s\n' \
        'deb [arch=amd64] http://archive.ubuntu.com/ubuntu bionic main universe multiverse restricted' \
        'deb [arch=amd64] http://archive.ubuntu.com/ubuntu bionic-updates main universe multiverse restricted' \
        'deb [arch=amd64] http://security.ubuntu.com/ubuntu bionic-security main universe multiverse restricted' \
        'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports bionic main universe multiverse restricted' \
        'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports bionic-updates main universe multiverse restricted' \
        'deb [arch=arm64] http://ports.ubuntu.com/ubuntu-ports bionic-security main universe multiverse restricted' \
        > /etc/apt/sources.list \
    && dpkg --add-architecture arm64 \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        file \
        ca-certificates \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        gcc-8-aarch64-linux-gnu \
        g++-8-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        libgstreamer1.0-dev:arm64 \
        libgstreamer-plugins-base1.0-dev:arm64 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY . .

ENV PKG_CONFIG_LIBDIR=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig

RUN cmake -H. -Bbuild-arm64 \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/aarch64-ubuntu18.04.cmake \
    && cmake --build build-arm64 -- -j2 \
    && file build-arm64/edgeplant-video-streamer-cpp
